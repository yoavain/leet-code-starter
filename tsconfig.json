{
    "extends": "./node_modules/@tsconfig/node24/tsconfig.json",
    "compilerOptions": {
        "strict": false,
        "esModuleInterop": true,
        "allowJs": true,
        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": false,
        "types": ["node", "jest"]
    },
    "include": ["./src/**/*", "*.ts", "*.mjs"]
}
